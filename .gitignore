# Build output
code/out/
build/
*.spv

# Downloaded assets (see bootstrap.json / tools/bootstrap.py)
assets/*
!assets/.gitkeep
# ...except the textures this project draws itself, which are committed so that a
# fresh clone can run the texture chapters without fetching anything.
# Regenerate with tools/make_textures.py.
!assets/textures/

# Site
site/node_modules/
site/dist/
site/.astro/

# Editors and tooling
.vscode/
.idea/
.cache/
compile_commands.json

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Screenshots produced by a manual capture run; reference images are committed
# explicitly under site/public/img/reference/
/captures/
